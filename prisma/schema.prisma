generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Channel {
  id               String            @id
  title            String
  handle           String?
  createdAt        DateTime          @default(now())
  videos           Video[]
  excludedKeywords ExcludedKeyword[]
  keywordCache     KeywordCache?
}

model ExcludedKeyword {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  word      String
  createdAt DateTime @default(now())

  @@unique([channelId, word])
}

model Video {
  id            String    @id
  channelId     String
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title         String
  thumbnailUrl  String?
  publishedAt   DateTime
  isMembersOnly Boolean   @default(false)
  monitored     Boolean   @default(false)
  lastScrapedAt DateTime?
  comments      Comment[]

  @@index([channelId])
}

model Comment {
  id               String           @id
  videoId          String
  video            Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parentId         String?
  authorName       String
  authorProfileUrl String?
  textOriginal     String
  likeCount        Int              @default(0)
  publishedAt      DateTime
  updatedAt        DateTime
  isDeleted        Boolean          @default(false)
  deletedAt        DateTime?
  history          CommentHistory[]

  @@index([videoId])
}

model CommentHistory {
  id           String   @id @default(cuid())
  commentId    String
  comment      Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  textOriginal String
  likeCount    Int
  updatedAt    DateTime
  capturedAt   DateTime @default(now())

  @@index([commentId])
}

model KeywordCache {
  channelId    String   @id
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  frequencies  Json
  commentCount Int
  updatedAt    DateTime @updatedAt
}

model GoogleAuth {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  scope        String
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AccessLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  authorized Boolean
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
